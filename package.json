{
  "name": "intraforge-spareparts-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "catalogue:import": "tsx scripts/import-package.ts",
    "format": "prettier --write src tests docs *.json *.ts *.md",
    "format:check": "prettier --check src tests docs *.json *.ts *.md"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "qrcode": "1.5.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
